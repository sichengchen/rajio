{
  "name": "@rajio-app/desktop",
  "version": "0.11.0",
  "private": true,
  "description": "New podCast player: Listen and Explore.",
  "type": "module",
  "main": "scripts/electron-entry.cjs",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names renderer,electron \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"tsx ./scripts/start-electron-dev.ts\"",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "pnpm --filter @rajio-app/core-wasm build && vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.config.ts",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "check": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "preview": "pnpm build && electron ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@radix-ui/react-alert-dialog": "1.1.14",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-scroll-area": "1.2.9",
    "@radix-ui/react-select": "2.2.5",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slider": "1.3.5",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.5",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-toggle": "1.1.9",
    "@radix-ui/react-tooltip": "1.2.7",
    "@rajio-app/contracts": "workspace:*",
    "@rajio-app/core-wasm": "workspace:*",
    "@tanstack/react-query": "5.99.1",
    "@tanstack/react-router": "1.168.23",
    "@vitejs/plugin-react": "^5.1.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "3.2.6",
    "fast-xml-parser": "^5.0.0",
    "iso-639-1": "^3.1.5",
    "lucide-react": "0.525.0",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "2.0.6",
    "tailwind-merge": "3.3.1",
    "vaul": "1.1.2",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.17.58",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "tailwindcss": "4.1.11",
    "tsx": "^4.20.6",
    "tw-animate-css": "1.3.5",
    "typescript": "^5.8.3",
    "vite": "^8.0.8"
  },
  "build": {
    "appId": "com.scchan.rajio",
    "productName": "Rajio",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/Assets.car",
        "to": "Assets.car"
      },
      {
        "from": "resources/icon-macos.png",
        "to": "icon-macos.png"
      },
      {
        "from": "resources/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "resources/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "files": [
      "dist/**",
      "package.json",
      "scripts/electron-entry.cjs"
    ],
    "mac": {
      "category": "public.app-category.music",
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "icon": "resources/Rajio.icns",
      "notarize": true,
      "x64ArchFiles": "**/node_modules/better-sqlite3/prebuilds/*.node",
      "target": [
        {
          "arch": [
            "universal"
          ],
          "target": "dmg"
        }
      ],
      "extendInfo": {
        "CFBundleIconName": "Rajio"
      }
    },
    "win": {
      "icon": "resources/icon.png"
    },
    "linux": {
      "category": "Audio",
      "icon": "resources/icon.png"
    }
  },
  "productName": "Rajio"
}
