{
  "name": "progressive-cast",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check": "vp run -r check",
    "test": "vp run -r test",
    "dev:desktop": "pnpm --filter @rajio-app/desktop dev",
    "test:all": "pnpm test",
    "preview": "vp run -r preview",
    "cf:deploy": "bash ./scripts/deploy-cloudflare.sh",
    "mobile:start": "pnpm --filter @rajio-app/mobile start",
    "mobile:ios": "pnpm --filter @rajio-app/mobile ios",
    "mobile:android": "pnpm --filter @rajio-app/mobile android",
    "setup:desktop": "bash scripts/setup-desktop.sh"
  },
  "devDependencies": {
    "vite-plus": "^0.1.16"
  },
  "packageManager": "pnpm@10.12.1"
}
